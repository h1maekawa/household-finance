NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI providers. Keep these server-side only.
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_VISION_API_KEY=

# Gmail import via Google Apps Script (see docs/gmail-import-setup.md).
# GAS_IMPORT_SECRET: random shared secret, also set in the GAS Script Properties.
# GAS_IMPORT_USER_ID: the auth.users.id that imported transactions belong to.
GAS_IMPORT_SECRET=
GAS_IMPORT_USER_ID=

# Stripe. STRIPE_WEBHOOK_SECRET は Webhook の署名検証に必須。
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=

# 課金チェック。サーバー専用（NEXT_PUBLIC_ にしないこと）。
# Production では値に関わらず常に有効で、設定漏れで全機能が開放されることはない。
# 開発・テストでだけ BILLING_REQUIRED=false で明示的に外せる。
BILLING_REQUIRED=
